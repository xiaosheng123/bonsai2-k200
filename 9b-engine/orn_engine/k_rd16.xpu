#include <xpu/runtime.h>
#include "xpu/kernel/cluster_header.h"
#include "xpu/kernel/math.h"
__global__ void lm_k(const unsigned char *W, float *out) {
    int tid = cluster_id() * core_num() + core_id();
    __local__ unsigned char buf[16384];
    GM2LM(W, buf, 16384);
    int acc = 0;
    for (int i = 0; i < 16384; i += 512) acc += buf[i];
    out[tid] = (float)acc;
}
void run_lm(const void *W, void *out, int cl, int co) { lm_k<<<cl, co>>>((const unsigned char *)W, (float *)out); }
