#include <xpu/runtime.h>
#include "xpu/kernel/cluster_header.h"
#include "xpu/kernel/math.h"

// ============================================================================
// kqk2.xpu —— 优化版: 减少 GM2LM 次数 (同一行整块一次性载入 local)
//   实测 v1: 每 (行 x super-block) 一次 144B/210B GM2LM => ~30us/次 => grp_ffn 101ms
//   v2:  激活整个 N 载入 1 次 (m 循环外); 每行权重整块载入 1 次 => GM2LM 次数 /16
// ============================================================================
#define QK2_MAXN 12288
#define QK2_RB   128
#define HW_CORE 16
#define KQK2_TID (cluster_id() * HW_CORE + (core_id() & (HW_CORE - 1)))
#define KQK2_NT  (cluster_num() * HW_CORE)

#define QK2_D(p) ({ unsigned short hh__ = *(const unsigned short *)(p); \
    unsigned s__ = (unsigned)(hh__ & 0x8000) << 16; \
    int e__ = (hh__ >> 10) & 0x1f; unsigned m__ = hh__ & 0x3ff, u__; \
    if (e__ == 0) { if (!m__) u__ = s__; else { int sh__ = 0; while (!(m__ & 0x400)) { m__ <<= 1; sh__++; } m__ &= 0x3ff; \
                   u__ = s__ | ((unsigned)(127 - 15 - sh__) << 23) | (m__ << 13); } } \
    else if (e__ == 31) u__ = s__ | 0x7f800000u | (m__ << 13); \
    else u__ = s__ | ((unsigned)(e__ - 15 + 127) << 23) | (m__ << 13); \
    float f__; __builtin_memcpy(&f__, &u__, 4); f__; })

#define QK2_GSM(j, q, pd, pm) do { \
    if ((j) < 4) { *(pd) = (q)[j] & 63;            *(pm) = (q)[(j) + 4] & 63; } \
    else { *(pd) = ((q)[(j)+4] & 0xF) | (((q)[(j)-4] >> 6) << 4); \
           *(pm) = ((q)[(j)+4] >>  4) | (((q)[(j)  ] >> 6) << 4); } } while (0)

// ---------------- Q4_K v2 ----------------
__global__ void gemv_q4k2_i8_k(const unsigned char *W, const unsigned char *xq,
                               const float *xs, float *y, int M, int N) {
    int tid = KQK2_TID, nthr = KQK2_NT;
    __local__ signed char   lx[QK2_MAXN];
    __local__ float         lxs[QK2_MAXN / 32];
    __local__ int           lb[QK2_MAXN / 32];
    __local__ unsigned char lw[QK2_MAXN / 256 * 144];
    int nb = N / 256;
    long rowstride = (long)nb * 144;
    int rows_per = (M + nthr - 1) / nthr; rows_per = (rows_per + 3) & ~3;
    int m0 = tid * rows_per; if (m0 >= M) return;
    int m1 = m0 + rows_per; if (m1 > M) m1 = M;
    // 激活与 Σxq 与行无关: 一次载入
    {
        int _n = N; for (int _c = 0; _c < _n; _c += 1024) {
            int _cc = (_n - _c < 1024) ? (_n - _c) : 1024;
            GM2LM(xq + _c, (unsigned char *)lx + _c, _cc); } }
    {
        int _n = (N / 32); for (int _c = 0; _c < _n; _c += 256) {
            int _cc = (_n - _c < 256) ? (_n - _c) : 256;
            GM2LM(xs + _c, lxs + _c, _cc * 4); } }
    for (int g = 0; g < N / 32; g++) {
        int s = 0;
        for (int i = 0; i < 32; i++) s += (int)lx[g * 32 + i];
        lb[g] = s;
    }
    for (int m = m0; m < m1; m++) {
        {
            size_t _n = (size_t)nb * 144; for (size_t _c = 0; _c < _n; _c += 1024) {
                size_t _cc = (_n - _c < 1024) ? (_n - _c) : 1024;
                GM2LM(W + (long)m * rowstride + _c, lw + _c, (int)_cc); } }   // ★ 整行分块
        float a = 0.f;
        for (int jb = 0; jb < nb; jb++) {
            const unsigned char *blk = lw + jb * 144;
            float d  = QK2_D(blk + 0);
            float dm = QK2_D(blk + 2);
            const unsigned char *sc = blk + 4;
            const unsigned char *qs = blk + 16;
            const signed char *xl = lx + jb * 256;
            int j32 = jb * 8;
            for (int jg = 0; jg < 4; jg++) {
                int is = 2 * jg, s1, mm1, s2, mm2;
                QK2_GSM(is, sc, &s1, &mm1);
                QK2_GSM(is + 1, sc, &s2, &mm2);
                const unsigned char *q4 = qs + jg * 32;
                int A1 = 0, A2 = 0;
                for (int i = 0; i < 32; i++) {
                    A1 += (int)(q4[i] & 0x0F) * (int)xl[jg * 64 + i];
                    A2 += (int)(q4[i] >> 4)   * (int)xl[jg * 64 + 32 + i];
                }
                a += d * (float)s1 * lxs[j32 + is]     * (float)A1
                   - dm * (float)mm1 * lxs[j32 + is]   * (float)lb[j32 + is]
                   + d * (float)s2 * lxs[j32 + is + 1] * (float)A2
                   - dm * (float)mm2 * lxs[j32 + is+1] * (float)lb[j32 + is + 1];
            }
        }
        y[m] = a;
    }
}

// ---------------- Q6_K v2 ----------------
__global__ void gemv_q6k2_i8_k(const unsigned char *W, const unsigned char *xq,
                               const float *xs, float *y, int M, int N) {
    int tid = KQK2_TID, nthr = KQK2_NT;
    __local__ signed char   lx[QK2_MAXN];
    __local__ float         lxs[QK2_MAXN / 32];
    __local__ unsigned char lw[QK2_MAXN / 256 * 210];
    int nb = N / 256;
    long rowstride = (long)nb * 210;
    int rows_per = (M + nthr - 1) / nthr; rows_per = (rows_per + 3) & ~3;
    int m0 = tid * rows_per; if (m0 >= M) return;
    int m1 = m0 + rows_per; if (m1 > M) m1 = M;
    GM2LM(xq, (unsigned char *)lx, N);
    GM2LM(xs, lxs, (N / 32) * 4);
    for (int m = m0; m < m1; m++) {
        {
            size_t _n = (size_t)nb * 210; for (size_t _c = 0; _c < _n; _c += 1024) {
                size_t _cc = (_n - _c < 1024) ? (_n - _c) : 1024;
                GM2LM(W + (long)m * rowstride + _c, lw + _c, (int)_cc); } }   // ★ 整行分块
        float a = 0.f;
        for (int jb = 0; jb < nb; jb++) {
            const unsigned char *blk = lw + jb * 210;
            float d = QK2_D(blk + 208);
            const unsigned char *ql = blk;
            const unsigned char *qh = blk + 128;
            const signed char   *sc = (const signed char *)(blk + 192);
            const signed char   *xl = lx + jb * 256;
            int j32 = jb * 8;
            for (int half = 0; half < 2; half++) {
                const unsigned char *qlh = ql + half * 64;
                const unsigned char *qhh = qh + half * 32;
                const signed char   *hp  = xl + half * 128;
                float s0 = lxs[j32+half*4+0], s1 = lxs[j32+half*4+1], s2 = lxs[j32+half*4+2], s3 = lxs[j32+half*4+3];
                for (int l = 0; l < 32; l++) {
                    int is = l >> 4;
                    int q1 = (int)((qlh[l]      & 0x0F) | ((unsigned)((qhh[l] >> 0) & 3) << 4)) - 32;
                    int q2 = (int)((qlh[l + 32] & 0x0F) | ((unsigned)((qhh[l] >> 2) & 3) << 4)) - 32;
                    int q3 = (int)((qlh[l]      >>  4) | ((unsigned)((qhh[l] >> 4) & 3) << 4)) - 32;
                    int q4 = (int)((qlh[l + 32] >>  4) | ((unsigned)((qhh[l] >> 6) & 3) << 4)) - 32;
                    a += (float)q1 * (float)hp[l]      * (float)sc[is+0] * s0
                       + (float)q2 * (float)hp[l + 32] * (float)sc[is+2] * s1
                       + (float)q3 * (float)hp[l + 64] * (float)sc[is+4] * s2
                       + (float)q4 * (float)hp[l + 96] * (float)sc[is+6] * s3;
                }
            }
            a *= d;
        }
        y[m] = a;
    }
}

void run_gemv_q4k2(int cl, int co, const void *W, const void *xq, const void *xs,
                   void *y, int M, int N) {
    gemv_q4k2_i8_k<<<cl, co>>>((const unsigned char *)W, (const unsigned char *)xq,
                               (const float *)xs, (float *)y, M, N);
}
void run_gemv_q6k2(int cl, int co, const void *W, const void *xq, const void *xs,
                   void *y, int M, int N) {
    gemv_q6k2_i8_k<<<cl, co>>>((const unsigned char *)W, (const unsigned char *)xq,
                               (const float *)xs, (float *)y, M, N);
}