#include <xpu/runtime.h>
#include "xpu/kernel/cluster_header.h"
#include "xpu/kernel/math.h"

// Diagnostic: read inputs via GM2LM, copy to out, verify data path
__global__ void ddiag_kernel(
    float *S,
    const float *k,
    const float *v,
    const float *q,
    const float *g,
    const float *b,
    float *out
) {
    int cid = core_id();
    int ncores = core_num();
    __local__ float l[16];
    // read first 4 of each input via GM2LM
    GM2LM(S, l, 16);       // S[0..3]
    out[cid % 4] = l[cid % 4];          // copy S[0..3]
    GM2LM(k, l, 16);       // k[0..3]
    out[4 + (cid % 4)] = l[cid % 4];
    GM2LM(q, l, 16);       // q[0..3]
    out[8 + (cid % 4)] = l[cid % 4];
    GM2LM(v, l, 16);       // v[0..3]
    out[12 + (cid % 4)] = l[cid % 4];
    GM2LM(g, l, 4);        // g[0]
    out[16 + (cid % 4)] = l[0];
    GM2LM(b, l, 4);        // b[0]
    out[20 + (cid % 4)] = l[0];
    out[24 + (cid % 4)] = (float)cid;
}

void run_ddiag(int cl, int co,
    float *S, const float *k, const float *v, const float *q,
    const float *g, const float *b, float *out) {
    ddiag_kernel<<<cl, co>>>(S, k, v, q, g, b, out);
}