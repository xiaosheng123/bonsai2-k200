#include <xpu/runtime.h>
#include "xpu/kernel/cluster_header.h"
#include "xpu/kernel/math.h"

#define VHD 128
#define KHD 128
#define NVH 32
#define NC 16
#define RPC 8

#define PACKED_PER_HV (2 + KHD + KHD + VHD)  // 386 floats = 1544 bytes
#define S_PER_HV (RPC * KHD)  // 1024 floats = 4096 bytes

__global__ void dn_k_T_merged_unroll(
    float *S,
    const float *packed_in,
    float *outT,
    int T
) {
    int cl = cluster_id();
    int ncl = cluster_num();
    int cid = core_id();
    if (cid >= NC) return;
    int hstart = (int)((long long)cl * NVH / ncl);
    int hend = (int)((long long)(cl + 1) * NVH / ncl);
    if (hstart >= NVH) return;

    __local__ float kl[KHD];
    __local__ float ql[KHD];
    __local__ float vl[VHD];
    __local__ float lr[RPC][KHD];
    __local__ float ob[RPC];
    __local__ float packed_l[PACKED_PER_HV];

    float qscale = 1.0f / sqrt((float)KHD);
    int r0 = cid * RPC;

    for (int hv = hstart; hv < hend; hv++) {
        int hk = hv % 16;
        __global_ptr__ float *sp = S + (size_t)hv * VHD * KHD + (size_t)r0 * KHD;
        
        GM2LM(sp, lr, S_PER_HV * 4);

        for (int t = 0; t < T; t++) {
            __global_ptr__ const float *src = packed_in + (size_t)t * NVH * PACKED_PER_HV + (size_t)hv * PACKED_PER_HV;
            GM2LM(src, packed_l, PACKED_PER_HV * 4);

            float eg = packed_l[0];
            float bb = packed_l[1];
            float *kp = packed_l + 2;
            float *qp = packed_l + 2 + KHD;
            float *vp = packed_l + 2 + KHD + KHD;

            // Unrolled copy (4 elements per iteration)
            #pragma unroll
            for (int i = 0; i < KHD; i += 4) {
                kl[i+0] = kp[i+0]; kl[i+1] = kp[i+1]; kl[i+2] = kp[i+2]; kl[i+3] = kp[i+3];
                ql[i+0] = qp[i+0]; ql[i+1] = qp[i+1]; ql[i+2] = qp[i+2]; ql[i+3] = qp[i+3];
            }
            #pragma unroll
            for (int i = 0; i < VHD; i += 4) {
                vl[i+0] = vp[i+0]; vl[i+1] = vp[i+1]; vl[i+2] = vp[i+2]; vl[i+3] = vp[i+3];
            }

            for (int rr = 0; rr < RPC; rr++) {
                int row = r0 + rr;
                // 段1: a0 = r*eg (写回), sk += a0*k
                float sk = 0.f;
                #pragma unroll
                for (int i = 0; i < KHD; i += 4) {
                    float a0_0 = lr[rr][i+0] * eg;
                    float a0_1 = lr[rr][i+1] * eg;
                    float a0_2 = lr[rr][i+2] * eg;
                    float a0_3 = lr[rr][i+3] * eg;
                    lr[rr][i+0] = a0_0;
                    lr[rr][i+1] = a0_1;
                    lr[rr][i+2] = a0_2;
                    lr[rr][i+3] = a0_3;
                    sk += a0_0 * kl[i+0] + a0_1 * kl[i+1] + a0_2 * kl[i+2] + a0_3 * kl[i+3];
                }
                float d = (vl[row] - sk) * bb;
                // 段2: u = r + k*d (写回), so += u*q
                float so = 0.f;
                #pragma unroll
                for (int i = 0; i < KHD; i += 4) {
                    float a0_0 = lr[rr][i+0] + kl[i+0] * d;
                    float a0_1 = lr[rr][i+1] + kl[i+1] * d;
                    float a0_2 = lr[rr][i+2] + kl[i+2] * d;
                    float a0_3 = lr[rr][i+3] + kl[i+3] * d;
                    lr[rr][i+0] = a0_0;
                    lr[rr][i+1] = a0_1;
                    lr[rr][i+2] = a0_2;
                    lr[rr][i+3] = a0_3;
                    so += a0_0 * ql[i+0] + a0_1 * ql[i+1] + a0_2 * ql[i+2] + a0_3 * ql[i+3];
                }
                ob[rr] = so * qscale;
            }
            __global_ptr__ float *ot = outT + ((size_t)t * NVH + hv) * VHD + r0;
            LM2GM(ob, ot, RPC * 4);
        }
        LM2GM(lr, sp, S_PER_HV * 4);
    }
}

void run_delta_net_batch_merged_unroll(int clusters, int cores, int T, float *S, const float *packed_in, float *outT) {
    dn_k_T_merged_unroll<<<clusters, cores>>>(S, packed_in, outT, T);
}